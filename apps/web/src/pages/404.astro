---
import { Font } from "astro:assets";
import "@/styles/globals.css";

import { getCvOrNull } from "@/lib/cv-source";

const cv = await getCvOrNull();
const name = cv?.name ?? "Home";
const headline = cv?.headline ?? "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-geist-mono" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <title>Page not found · {name}</title>
    <meta
      name="description"
      content={`The page you’re looking for doesn’t exist. Visit ${name}’s CV.`}
    />
  </head>
  <body
    class="bg-background text-foreground min-h-dvh flex items-center justify-center px-6"
  >
    <main class="max-w-md text-center space-y-4">
      <p class="text-sm font-mono text-muted-foreground tracking-widest">404</p>
      <h1 class="text-2xl font-bold">Page not found</h1>
      <p class="text-muted-foreground">
        The page you’re looking for doesn’t exist or has moved.
      </p>
      {headline && <p class="text-sm text-muted-foreground">{headline}</p>}
      <a
        href="/"
        class="inline-flex min-h-11 items-center justify-center rounded-md border border-border bg-background px-4 py-2 text-sm font-medium hover:bg-accent hover:text-accent-foreground active:bg-foreground/10 transition-colors"
      >
        Back to {name}’s CV
      </a>
    </main>
  </body>
</html>
