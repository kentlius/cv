---
import * as React from "react";
import { GlobeIcon, MailIcon, PhoneIcon } from "lucide-react";

import "@/styles/globals.css";

import { getEntry } from "astro:content";

import { AvatarWrapper } from "@/components/avatar-wrapper";
import { CommandMenu } from "@/components/command-menu";
import { ContactLink } from "@/components/contact-link";
import { GitHubIcon, LinkedInIcon } from "@/components/icons/brand-icons";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import { Section } from "@/components/ui/section";

const cvEntry = await getEntry("cv", "kent");
if (!cvEntry) {
  throw new Error("CV not found in content collection");
}
const cv = cvEntry.data.cv;

function formatDate(value: string | undefined): string {
  if (!value) return "";
  const v = value.trim();
  if (v.toLowerCase() === "present") return "Present";
  if (/^\d{4}-\d{2}$/.test(v)) {
    const [year, month] = v.split("-");
    const date = new Date(Number(year), Number(month) - 1, 1);
    return date.toLocaleString("en-US", {
      month: "short",
      year: "numeric",
    });
  }
  if (/^\d{4}$/.test(v)) return v;
  return v;
}

function formatRange(start: string | undefined, end: string | undefined): string {
  const s = formatDate(start);
  const e = formatDate(end);
  if (s && e) return `${s} – ${e}`;
  if (s) return s;
  if (e) return e;
  return "";
}

const SOCIAL_URLS: Record<string, (username: string) => string> = {
  LinkedIn: (u) => `https://linkedin.com/in/${u}`,
  GitHub: (u) => `https://github.com/${u}`,
  Twitter: (u) => `https://x.com/${u}`,
  X: (u) => `https://x.com/${u}`,
  Instagram: (u) => `https://instagram.com/${u}`,
  YouTube: (u) => `https://youtube.com/@${u}`,
  Facebook: (u) => `https://facebook.com/${u}`,
  Website: (u) => (u.startsWith("http") ? u : `https://${u}`),
};

function socialUrl(network: string, username: string): string {
  const fn = SOCIAL_URLS[network];
  return fn ? fn(username) : `https://${username}`;
}

const NETWORK_ICON: Record<
  string,
  React.ComponentType<{ className?: string }>
> = {
  LinkedIn: LinkedInIcon,
  GitHub: GitHubIcon,
};

function parseMarkdownLink(
  text: string | undefined,
): { text: string; href: string } | null {
  if (!text) return null;
  const m = /^\[([^\]]+)\]\(([^)]+)\)\s*$/.exec(text.trim());
  return m ? { text: m[1], href: m[2] } : null;
}

const initials = cv.name
  .split(/\s+/)
  .map((part) => part[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const locationQuery = encodeURIComponent(cv.location ?? "");
const locationHref = locationQuery
  ? `https://www.google.com/maps/search/?api=1&query=${locationQuery}`
  : undefined;

const experience = cv.sections?.experience ?? [];
const education = cv.sections?.education ?? [];
const certifications = cv.sections?.certifications ?? [];
const awards = cv.sections?.awards ?? [];
const skills = cv.sections?.skills ?? [];

const commandLinks = [
  ...(cv.email ? [{ url: `mailto:${cv.email}`, title: "Email" }] : []),
  ...(cv.phone ? [{ url: `tel:${cv.phone}`, title: "Phone" }] : []),
  ...(cv.social_networks ?? []).map((s) => ({
    url: socialUrl(s.network, s.username),
    title: s.network,
  })),
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{cv.name}</title>
    <meta name="description" content={cv.headline} />
    <meta name="author" content={cv.name} />
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="75aa81ff-9c6d-4ef9-8829-6eaca8616ba9"></script>
  </head>
  <body>
    <main
      class="container relative mx-auto scroll-my-12 overflow-auto p-4 print:p-12 md:p-16 selection:bg-fuchsia-300 selection:text-fuchsia-900"
    >
      <section
        class="mx-auto w-full max-w-2xl space-y-8 bg-white print:space-y-6"
      >
        <div class="flex items-center justify-between">
          <div class="flex-1 space-y-1.5">
            <h1 class="text-2xl font-bold">{cv.name}</h1>
            {cv.headline ? (
              <p
                class="max-w-md text-pretty font-mono text-sm text-muted-foreground"
              >
                {cv.headline}
              </p>
            ) : null}
            {cv.location ? (
              <p
                class="max-w-md items-center text-pretty font-mono text-xs text-muted-foreground"
              >
                {locationHref ? (
                  <a
                    class="inline-flex gap-x-1.5 align-baseline leading-none hover:underline"
                    href={locationHref}
                    target="_blank"
                    rel="noreferrer noopener"
                  >
                    <GlobeIcon />
                    {cv.location}
                  </a>
                ) : (
                  <span>{cv.location}</span>
                )}
              </p>
            ) : null}
            <div
              class="flex gap-x-1 pt-1 font-mono text-sm text-muted-foreground print:hidden"
            >
              {cv.email ? (
                <ContactLink
                  href={`mailto:${cv.email}`}
                  tooltip="Email"
                  client:load
                >
                  <MailIcon className="size-4" />
                </ContactLink>
              ) : null}
              {cv.phone ? (
                <ContactLink
                  href={`tel:${cv.phone}`}
                  tooltip="Phone"
                  client:load
                >
                  <PhoneIcon className="size-4" />
                </ContactLink>
              ) : null}
              {(cv.social_networks ?? []).map((social) => {
                const Icon = NETWORK_ICON[social.network];
                return (
                  <ContactLink
                    href={socialUrl(social.network, social.username)}
                    tooltip={social.network}
                    newtab={true}
                    client:load
                  >
                    {Icon ? <Icon className="size-4" /> : null}
                  </ContactLink>
                );
              })}
            </div>
            <div
              class="hidden flex-col gap-x-1 font-mono text-sm text-muted-foreground print:flex"
            >
              {cv.email ? (
                <a href={`mailto:${cv.email}`}>
                  <span class="underline">{cv.email}</span>
                </a>
              ) : null}
              {cv.phone ? (
                <a href={`tel:${cv.phone}`}>
                  <span class="underline">{cv.phone}</span>
                </a>
              ) : null}
            </div>
          </div>

          <AvatarWrapper
            name={cv.name}
            initials={initials}
            client:load
          />
        </div>

        {experience.length > 0 ? (
          <Section>
            <h2 class="text-xl font-bold">Work Experience</h2>
            {experience.map((job) => (
              <Card>
                <CardHeader>
                  <div class="flex items-center justify-between gap-x-2 text-base">
                    <h3 class="font-semibold leading-none">
                      {job.company}
                      {job.location ? (
                        <span class="ml-2 font-mono text-xs font-normal text-muted-foreground">
                          · {job.location}
                        </span>
                      ) : null}
                    </h3>
                    <div class="text-sm tabular-nums text-muted-foreground">
                      {formatRange(job.start_date, job.end_date)}
                    </div>
                  </div>
                  <h4 class="font-mono text-sm leading-none text-muted-foreground">
                    {job.position}
                  </h4>
                </CardHeader>
                {job.highlights && job.highlights.length > 0 ? (
                  <CardContent className="mt-2 text-xs">
                    <ul class="list-disc space-y-1 pl-4">
                      {job.highlights.map((h) => <li>{h}</li>)}
                    </ul>
                  </CardContent>
                ) : null}
              </Card>
            ))}
          </Section>
        ) : null}

        {education.length > 0 ? (
          <Section>
            <h2 class="text-xl font-bold">Education</h2>
            {education.map((ed) => (
              <Card>
                <CardHeader>
                  <div class="flex items-center justify-between gap-x-2 text-base">
                    <h3 class="font-semibold leading-none">
                      {ed.institution}
                      {ed.location ? (
                        <span class="ml-2 font-mono text-xs font-normal text-muted-foreground">
                          · {ed.location}
                        </span>
                      ) : null}
                    </h3>
                    <div class="text-sm tabular-nums text-muted-foreground">
                      {formatRange(ed.start_date, ed.end_date)}
                    </div>
                  </div>
                  {ed.area || ed.degree ? (
                    <h4 class="font-mono text-sm leading-none text-muted-foreground">
                      {[ed.degree, ed.area].filter(Boolean).join(" · ")}
                    </h4>
                  ) : null}
                </CardHeader>
                {ed.highlights && ed.highlights.length > 0 ? (
                  <CardContent className="mt-2 text-xs">
                    <ul class="list-disc space-y-1 pl-4">
                      {ed.highlights.map((h) => <li>{h}</li>)}
                    </ul>
                  </CardContent>
                ) : null}
              </Card>
            ))}
          </Section>
        ) : null}

        {certifications.length > 0 ? (
          <Section>
            <h2 class="text-xl font-bold">Certifications</h2>
            {certifications.map((cert) => {
              const link = parseMarkdownLink(cert.location);
              const detail = link?.text ?? cert.location;
              return (
                <Card>
                  <CardHeader>
                    <div
                      class="flex items-center justify-between gap-x-2 text-base"
                    >
                      <h3 class="font-semibold leading-none">
                        {link ? (
                          <a
                            class="hover:underline"
                            href={link.href}
                            target="_blank"
                            rel="noreferrer noopener"
                            data-confetti-hover
                          >
                            {cert.name}
                          </a>
                        ) : (
                          cert.name
                        )}
                      </h3>
                      {cert.date ? (
                        <div class="text-sm tabular-nums text-muted-foreground">
                          {formatDate(cert.date)}
                        </div>
                      ) : null}
                    </div>
                    {detail ? (
                      <h4 class="font-mono text-sm leading-none text-muted-foreground">
                        {detail}
                      </h4>
                    ) : null}
                    {cert.summary ? (
                      <p class="text-xs text-muted-foreground">
                        {cert.summary}
                      </p>
                    ) : null}
                  </CardHeader>
                </Card>
              );
            })}
          </Section>
        ) : null}

        {awards.length > 0 ? (
          <Section>
            <h2 class="text-xl font-bold">Honors &amp; Awards</h2>
            {awards.map((award) => {
              const link = parseMarkdownLink(award.location);
              return (
                <Card>
                  <CardHeader>
                    <div class="flex items-center justify-between gap-x-2 text-base">
                      <h3 class="font-semibold leading-none">
                        {link ? (
                          <a
                            class="hover:underline"
                            href={link.href}
                            target="_blank"
                            rel="noreferrer noopener"
                            data-confetti-hover
                          >
                            {award.name}
                          </a>
                        ) : (
                          award.name
                        )}
                      </h3>
                      {award.date ? (
                        <div class="text-sm tabular-nums text-muted-foreground">
                          {formatDate(award.date)}
                        </div>
                      ) : null}
                    </div>
                    {award.summary ? (
                      <p class="text-xs text-muted-foreground">
                        {award.summary}
                      </p>
                    ) : null}
                  </CardHeader>
                  {award.highlights && award.highlights.length > 0 ? (
                    <CardContent className="mt-2 text-xs">
                      <ul class="list-disc space-y-1 pl-4">
                        {award.highlights.map((h) => <li>{h}</li>)}
                      </ul>
                    </CardContent>
                  ) : null}
                </Card>
              );
            })}
          </Section>
        ) : null}

        {skills.length > 0 ? (
          <Section>
            <h2 class="text-xl font-bold">Skills</h2>
            <div class="space-y-3">
              {skills.map((group) => (
                <div class="space-y-1.5">
                  <p class="font-mono text-xs text-muted-foreground">
                    {group.label}
                  </p>
                  <div class="flex flex-wrap gap-1">
                    {group.details
                      .split(",")
                      .map((s) => s.trim())
                      .filter(Boolean)
                      .map((skill) => (
                        <Badge variant="secondary">{skill}</Badge>
                      ))}
                  </div>
                </div>
              ))}
            </div>
          </Section>
        ) : null}

        <CommandMenu links={commandLinks} client:load />
      </section>
    </main>
  </body>
</html>

<script>
  import confetti from "canvas-confetti";

  document.querySelectorAll("[data-confetti-hover]").forEach((element) => {
    element.addEventListener("mouseenter", (e) => {
      confetti({
        origin: {
          x: (e as MouseEvent).clientX / window.innerWidth,
          y: (e as MouseEvent).clientY / window.innerHeight,
        },
      });
    });
  });
</script>
