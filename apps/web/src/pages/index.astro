---
import "@/styles/globals.css";

import { Font } from "astro:assets";
import Awards from "@/components/cv/awards.astro";
import Certifications from "@/components/cv/certifications.astro";
import CvHeader from "@/components/cv/cv-header.astro";
import Education from "@/components/cv/education.astro";
import Experience from "@/components/cv/experience.astro";
import Skills from "@/components/cv/skills.astro";
import SiteFooter from "@/components/site-footer.astro";
import { getCv } from "@/lib/cv-source";
import { buildCvView } from "@/lib/cv-view";

const cv = await getCv();
const view = buildCvView(cv);

const siteUrl = Astro.site!.toString().replace(/\/$/, "");
const role = view.experience[0]?.position ?? "Curriculum vitae";
const description = `${view.profile.name} — ${role}${
  view.profile.locationLabel ? ` · ${view.profile.locationLabel}` : ""
}`;
const ogImage = `${siteUrl}/og.png`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <script is:inline>
      (() => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (!("IntersectionObserver" in window)) return;

        document.documentElement.classList.add("motion");

        const reveal = () => {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
          );

          document
            .querySelectorAll("[data-reveal], [data-intro]")
            .forEach((element) => observer.observe(element));

          document.addEventListener("focusin", (event) => {
            const target =
              event.target instanceof Element
                ? event.target.closest("[data-reveal], [data-intro]")
                : null;
            if (target) target.classList.add("is-visible");
          });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", reveal, { once: true });
        } else {
          reveal();
        }
      })();
    </script>
    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-geist-mono" />
    <meta name="generator" content={Astro.generator} />
    <title>{view.profile.name} — {role}</title>
    <meta name="description" content={description} />
    <meta name="author" content={view.profile.name} />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${view.profile.name} — CV`} />
    <meta property="og:title" content={`${view.profile.name} — ${role}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${view.profile.name} — ${role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${view.profile.name} — ${role}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${view.profile.name} — ${role}`} />
  </head>
  <body>
    <main
      class="container relative mx-auto p-4 pb-[calc(1rem+env(safe-area-inset-bottom,0px))] pl-[max(1rem,env(safe-area-inset-left,0px))] pr-[max(1rem,env(safe-area-inset-right,0px))] print:p-12 md:p-16 selection:bg-fuchsia-300 selection:text-fuchsia-900"
    >
      <section
        class="mx-auto w-full max-w-2xl space-y-8 bg-white print:space-y-6"
      >
        <CvHeader
          profile={{
            ...view.profile,
            headline: view.profile.headline ?? view.experience[0]?.position,
          }}
          contacts={view.contacts}
        />

        <Experience items={view.experience} />
        <Education items={view.education} />
        <Certifications items={view.certifications} />
        <Awards items={view.awards} />
        <Skills groups={view.skills} />
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<script>
  type Confetti = typeof import("canvas-confetti").default;

  let confettiPromise: Promise<Confetti> | null = null;
  let activeConfetti: Confetti | null = null;
  let lastBurst = 0;

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

  const getConfetti = () =>
    (confettiPromise ??= import("canvas-confetti").then((module) => {
      activeConfetti = module.default;
      return activeConfetti;
    }));

  document.querySelectorAll("[data-confetti-hover]").forEach((element) => {
    element.addEventListener("mouseenter", async (event) => {
      if (!finePointer.matches || reduceMotion.matches) return;

      const now = performance.now();
      if (now - lastBurst < 600) return;
      lastBurst = now;

      const confetti = await getConfetti();
      const pointer = event as MouseEvent;
      confetti({
        disableForReducedMotion: true,
        origin: {
          x: pointer.clientX / window.innerWidth,
          y: pointer.clientY / window.innerHeight,
        },
      });
    });
  });

  window.addEventListener("beforeprint", () => activeConfetti?.reset());

  console.log(
    "%c KL %c Kent Liusudarso — Software Engineer ",
    "background:#0f172a;color:#fff;font-weight:700;padding:4px 8px;border-radius:6px 0 0 6px;font-size:12px",
    "background:#10b981;color:#022c22;font-weight:600;padding:4px 8px;border-radius:0 6px 6px 0;font-size:12px",
  );
  console.log(
    "%cYou found the console. This CV is one YAML file rendered three ways: web, PDF, and the embed you just came from.",
    "color:#64748b;font-style:italic",
  );
  console.log(
    "%c→ github.com/kentlius/cv",
    "color:#10b981;font-weight:600",
  );
  console.log(
    "%cP.S. The certification links throw confetti. That is the whole trick.",
    "color:#94a3b8;font-size:11px",
  );
</script>
