---
import { GLOBE_PINS } from "@/lib/globe-locations";

const pins = GLOBE_PINS;
const currentPin = pins.find((pin) => pin.current);
const markers = pins.map((pin) => ({
  location: pin.coords,
  size: pin.size,
  color: pin.color,
  id: pin.id,
}));
---

<footer
  class="relative w-full overflow-hidden selection:bg-fuchsia-300 selection:text-fuchsia-900 print:hidden"
  data-reveal
>
  <div
    id="globe"
    class="relative w-full overflow-hidden"
    style="--globe-size: min(100vw, 90rem); height: calc(var(--globe-size) / 2);"
    data-globe-stage
  >
    <div
      class="absolute left-1/2 top-0 h-[var(--globe-size)] w-[var(--globe-size)] -translate-x-1/2 overflow-hidden rounded-full"
      data-globe-shell
    >
      <canvas
        width="440"
        height="440"
        class="absolute inset-0 size-full touch-pan-y outline-none"
        aria-hidden="true"
        tabindex="-1"
        role="img"
        aria-label={`Interactive globe of experience locations: ${pins.map((pin) => pin.place).join(", ")}. Drag or use arrow keys to rotate.`}
        aria-describedby="globe-instructions"
        data-globe
        data-markers={JSON.stringify(markers)}
      ></canvas>

      <svg
        viewBox="0 0 100 100"
        class="pointer-events-none absolute inset-0 size-full text-muted-foreground/60"
        aria-hidden="true"
        data-globe-fallback
      >
        <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
          <circle
            cx="50"
            cy="50"
            r="46"
            fill="currentColor"
            fill-opacity="0.055"
            vector-effect="non-scaling-stroke"
          />
        </g>
        <g data-globe-fallback-pins class="text-foreground" fill="currentColor">
          {
            pins.map((pin) => (
              <circle
                cx={pin.staticX}
                cy={pin.staticY}
                r={pin.current ? 0.6 : 0.45}
              />
            ))
          }
        </g>
      </svg>

      {
        pins.map((pin) => (
          <span
            class="globe-label"
            data-globe-label={pin.id}
            data-side={pin.labelSide}
            aria-hidden="true"
            style={`position-anchor: --cobe-${pin.id}; --globe-visible: var(--cobe-visible-${pin.id}, 0);`}
          >
            {pin.place}
          </span>
        ))
      }

      {
        pins.map((pin) => (
          <span
            class="globe-static-label"
            data-globe-static-label={pin.id}
            data-side={pin.labelSide}
            style={`--pin-x: ${pin.staticX}%; --pin-y: ${pin.staticY}%;`}
            aria-hidden="true"
          >
            {pin.place}
          </span>
        ))
      }

      {currentPin ? (
        <div
          class="globe-pulse"
          aria-hidden="true"
          style={`position-anchor: --cobe-${currentPin.id}; --globe-visible: var(--cobe-visible-${currentPin.id}, 0);`}
        >
          <span class="globe-pulse-ring"></span>
          <span class="globe-pulse-ring"></span>
          <span class="globe-pulse-dot"></span>
        </div>
      ) : null}
    </div>
  </div>

  <p id="globe-instructions" class="sr-only">
    Drag the globe or use the arrow keys to rotate it. Location links in the CV
    scroll here and highlight their pin. The Kalbe Farma role was remote.
  </p>
</footer>

<style>
  [data-globe-shell]:has(canvas:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 4px;
  }

  [data-globe-shell][data-ready] canvas {
    cursor: grab;
  }

  [data-globe-shell][data-ready] canvas:active {
    cursor: grabbing;
  }

  [data-globe-fallback],
  .globe-static-label {
    transition: opacity 240ms ease-out;
  }

  [data-globe-shell][data-ready] [data-globe-fallback],
  [data-globe-shell][data-ready] [data-globe-static-label] {
    opacity: 0;
  }

  [data-globe-shell] {
    --ink: var(--color-foreground);
    --bg: var(--color-background);
  }

  .globe-label,
  .globe-static-label {
    position: absolute;
    z-index: 10;
    padding: 0.15rem 0.35rem;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono, monospace);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.3s, filter 0.3s;
  }

  .globe-label {
    display: none;
  }

  @supports (position-anchor: --test) {
    .globe-label {
      display: block;
      opacity: var(--globe-visible, 0);
      filter: blur(calc((1 - var(--globe-visible, 0)) * 8px));
    }
  }

  .globe-label[data-side="above"] {
    bottom: anchor(top);
    left: anchor(center);
    translate: -50% 0;
    margin-bottom: 8px;
  }

  .globe-label[data-side="below"] {
    top: anchor(bottom);
    left: anchor(center);
    translate: -50% 0;
    margin-top: 8px;
  }

  .globe-label::after,
  .globe-static-label::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate3d(-50%, -1px, 0);
    border: 5px solid transparent;
    border-top-color: var(--ink);
  }

  .globe-label[data-side="below"]::after,
  .globe-static-label[data-side="below"]::after {
    top: auto;
    bottom: 100%;
    transform: translate3d(-50%, 1px, 0);
    border-top-color: transparent;
    border-bottom-color: var(--ink);
  }

  .globe-static-label {
    display: block;
    left: var(--pin-x);
    top: var(--pin-y);
  }

  .globe-static-label[data-side="above"] {
    transform: translate(-50%, calc(-100% - 8px));
  }

  .globe-static-label[data-side="below"] {
    transform: translate(-50%, 8px);
  }

  .globe-pulse {
    position: absolute;
    z-index: 9;
    bottom: anchor(center);
    left: anchor(center);
    translate: -50% 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: var(--globe-visible, 0);
    filter: blur(calc((1 - var(--globe-visible, 0)) * 8px));
    pointer-events: none;
    transition: opacity 0.4s, filter 0.4s;
  }

  .globe-pulse-ring {
    position: absolute;
    inset: 0;
    border: 2px solid var(--ink);
    border-radius: 50%;
    opacity: 0;
    animation: pulse-expand 2s ease-out infinite;
    animation-delay: var(--delay, 0s);
  }

  .globe-pulse-ring:nth-child(2) {
    animation-delay: calc(var(--delay, 0s) + 0.5s);
  }

  @keyframes pulse-expand {
    0% {
      transform: scale(0.3);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  .globe-pulse-dot {
    width: 10px;
    height: 10px;
    background: var(--ink);
    border-radius: 50%;
    box-shadow:
      0 0 0 3px var(--bg),
      0 0 0 5px var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .globe-pulse-ring {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-globe]");
  const shell = document.querySelector<HTMLElement>("[data-globe-shell]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const globeStage = document.getElementById("globe");
  const locationLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('a[href="#globe"]'),
  );

  let focusFromLink: ((id: string) => void) | null = null;
  let pendingPin: string | null = null;

  for (const link of locationLinks) {
    link.addEventListener("click", (event) => {
      if (!globeStage) return;
      event.preventDefault();

      const id = link.dataset.globeFocus;
      if (id) {
        if (focusFromLink) focusFromLink(id);
        else pendingPin = id;
      } else {
        pendingPin = null;
      }

      globeStage.scrollIntoView({
        behavior: reduceMotion.matches ? "auto" : "smooth",
        block: "end",
      });
    });
  }

  if (canvas && shell) {
    const init = async () => {
      const probe = document.createElement("canvas");
      if (!(probe.getContext("webgl2") || probe.getContext("webgl"))) return;

      try {
        const { default: createGlobe } = await import("cobe");

        let size = Math.round(shell.getBoundingClientRect().width);
        let phi = 2.6;
        let theta = -0.32;
        let dragging = false;
        let hovering = false;
        let focused = false;
        let pointerId: number | null = null;
        let lastX = 0;
        let lastY = 0;
        let velocity = 0;
        let lastInteraction = performance.now();
        let activePin: string | null = null;
        let targetPhi: number | null = null;
        let raf = 0;
        let lastFrame = 0;
        let dirty = true;

        const markers = JSON.parse(canvas.dataset.markers ?? "[]") as {
          location: [number, number];
          size: number;
          color: [number, number, number];
          id?: string;
        }[];

        const globe = createGlobe(canvas, {
          devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
          width: size,
          height: size,
          phi,
          theta,
          dark: 0,
          diffuse: 1.2,
          scale: 1.2,
          mapSamples: 16000,
          mapBrightness: 6,
          mapBaseBrightness: 0,
          baseColor: [0.92, 0.92, 0.92],
          markerColor: [0.145, 0.145, 0.145],
          glowColor: [1, 1, 1],
          markers,
          markerElevation: 0.015,
        });

        const clamp = (value: number, min: number, max: number) =>
          Math.min(max, Math.max(min, value));
        const TWO_PI = Math.PI * 2;

        const setActivePin = (id: string | null) => {
          activePin = id;
        };

        const focusLocation = (id: string) => {
          const marker = markers.find((candidate) => candidate.id === id);
          if (!marker) return;

          const desiredPhi =
            Math.PI - ((marker.location[1] * Math.PI) / 180 - Math.PI / 2);
          const currentPhi = ((phi % TWO_PI) + TWO_PI) % TWO_PI;
          const goalPhi = ((desiredPhi % TWO_PI) + TWO_PI) % TWO_PI;
          let delta = goalPhi - currentPhi;
          if (delta > Math.PI) delta -= TWO_PI;
          else if (delta < -Math.PI) delta += TWO_PI;

          targetPhi = phi + delta;
          velocity = 0;
          setActivePin(id);
          lastInteraction = performance.now();
          dirty = true;
        };

        const frame = (now: number) => {
          const delta = lastFrame ? Math.min(now - lastFrame, 64) : 16.667;
          lastFrame = now;
          const step = delta / 16.667;
          let changed = false;

          if (targetPhi !== null) {
            if (reduceMotion.matches) {
              phi = targetPhi;
              targetPhi = null;
            } else {
              const distance = targetPhi - phi;
              if (Math.abs(distance) < 0.0005) {
                phi = targetPhi;
                targetPhi = null;
              } else {
                phi += distance * Math.min(1, 0.12 * step);
              }
            }
            changed = true;
          } else if (!dragging) {
            if (!reduceMotion.matches && Math.abs(velocity) > 0.0002) {
              phi += velocity * step;
              velocity *= Math.pow(0.92, step);
              if (Math.abs(velocity) <= 0.0002) velocity = 0;
              changed = true;
            } else if (
              !reduceMotion.matches &&
              !hovering &&
              !focused &&
              !activePin &&
              now - lastInteraction > 2400
            ) {
              phi += 0.0015 * step;
              changed = true;
            }
          }

          if (changed || dirty) {
            globe.update({ phi, theta });
            dirty = false;
          }

          raf = requestAnimationFrame(frame);
        };

        const startAnimation = () => {
          if (raf) return;
          lastFrame = performance.now();
          dirty = true;
          raf = requestAnimationFrame(frame);
        };

        const stopAnimation = () => {
          if (!raf) return;
          cancelAnimationFrame(raf);
          raf = 0;
          lastFrame = 0;
        };

        shell.dataset.ready = "true";
        canvas.removeAttribute("aria-hidden");
        canvas.tabIndex = 0;
        focusFromLink = focusLocation;
        if (pendingPin) {
          focusLocation(pendingPin);
          pendingPin = null;
        }

        if ("IntersectionObserver" in window) {
          const visibilityObserver = new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                startAnimation();
              } else {
                stopAnimation();
              }
            },
            { rootMargin: "100px" },
          );
          visibilityObserver.observe(shell);
        } else {
          startAnimation();
        }

        const endDrag = (event: PointerEvent) => {
          if (pointerId !== event.pointerId) return;
          dragging = false;
          pointerId = null;
          lastInteraction = performance.now();
          if (canvas.hasPointerCapture(event.pointerId)) {
            canvas.releasePointerCapture(event.pointerId);
          }
        };

        canvas.addEventListener("pointerdown", (event) => {
          if (event.pointerType === "mouse" && event.button !== 0) return;
          if (event.pointerType !== "touch") event.preventDefault();
          setActivePin(null);
          targetPhi = null;
          dragging = true;
          hovering = true;
          pointerId = event.pointerId;
          lastX = event.clientX;
          lastY = event.clientY;
          velocity = 0;
          lastInteraction = performance.now();
          canvas.setPointerCapture(event.pointerId);
        });

        canvas.addEventListener("pointermove", (event) => {
          if (!dragging || pointerId !== event.pointerId) return;
          if (event.pointerType !== "touch") event.preventDefault();

          const dx = event.clientX - lastX;
          const dy = event.clientY - lastY;
          lastX = event.clientX;
          lastY = event.clientY;

          phi += dx * 0.005;
          theta = clamp(theta + dy * 0.004, -0.75, 0.45);
          velocity = reduceMotion.matches ? 0 : dx * 0.005;
          lastInteraction = performance.now();
          dirty = true;
        });

        canvas.addEventListener("pointerup", endDrag);
        canvas.addEventListener("pointercancel", endDrag);
        canvas.addEventListener("lostpointercapture", endDrag);

        shell.addEventListener("pointerenter", () => {
          hovering = true;
        });

        shell.addEventListener("pointerleave", () => {
          hovering = false;
          lastInteraction = performance.now();
        });

        canvas.addEventListener("keydown", (event) => {
          const step = 0.12;
          let handled = true;

          switch (event.key) {
            case "ArrowLeft":
              phi -= step;
              break;
            case "ArrowRight":
              phi += step;
              break;
            case "ArrowUp":
              theta = clamp(theta - step, -0.75, 0.45);
              break;
            case "ArrowDown":
              theta = clamp(theta + step, -0.75, 0.45);
              break;
            case "Escape":
              break;
            default:
              handled = false;
          }

          if (!handled) return;
          event.preventDefault();
          targetPhi = null;
          setActivePin(null);
          velocity = 0;
          lastInteraction = performance.now();
          dirty = true;
        });

        canvas.addEventListener("focus", () => {
          focused = true;
          lastInteraction = performance.now();
        });

        canvas.addEventListener("blur", () => {
          focused = false;
          lastInteraction = performance.now();
        });

        window.addEventListener("resize", () => {
          const next = Math.round(shell.getBoundingClientRect().width);
          if (next === size) return;
          size = next;
          globe.update({ width: size, height: size, phi, theta });
        });
      } catch {
        // The static SVG globe and its labels remain.
      }
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          void init();
        },
        { rootMargin: "300px" },
      );
      observer.observe(shell);
    } else {
      void init();
    }
  }
</script>
