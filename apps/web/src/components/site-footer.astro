---
import type { ProfileView } from "@/lib/cv-view";

interface Props {
  profile: ProfileView;
}

const { profile } = Astro.props;
const location = profile.locationLabel ?? "Shizuoka, Japan";
const mapsUrl =
  profile.locationHref ??
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location)}`;

const pins = [
  {
    id: "shizuoka",
    place: "Shizuoka",
    detail: "current",
    coords: [34.9756, 138.3828] as [number, number],
    size: 0.042,
    current: true,
  },
  {
    id: "tangerang",
    place: "Tangerang",
    detail: "BCA · IMS",
    coords: [-6.1783, 106.6319] as [number, number],
    size: 0.019,
    current: false,
  },
  {
    id: "bandung",
    place: "Bandung",
    detail: "STEI ITB",
    coords: [-6.9175, 107.6191] as [number, number],
    size: 0.017,
    current: false,
  },
];

const markers = pins.map((pin) => ({
  location: pin.coords,
  size: pin.size,
  id: pin.id,
}));
---

<footer
  class="relative w-full overflow-hidden border-t border-border selection:bg-fuchsia-300 selection:text-fuchsia-900 print:hidden"
  data-reveal
>
  <div
    class="mx-auto flex w-full max-w-2xl flex-col gap-8 px-4 pb-8 pt-10 sm:flex-row sm:items-start sm:justify-between md:pb-10 md:pt-12"
  >
    <div class="min-w-0 space-y-1.5">
      <p class="font-mono text-xs text-muted-foreground">Based in</p>
      <a
        class="inline-flex max-w-full items-center gap-x-1.5 font-mono text-sm leading-tight text-muted-foreground hover:underline"
        href={mapsUrl}
        target="_blank"
        rel="noreferrer noopener"
      >
        {location}
      </a>
      <a
        class="block font-mono text-xs text-muted-foreground hover:underline"
        href="https://github.com/kentlius/cv"
        target="_blank"
        rel="noreferrer noopener"
      >
        github.com/kentlius/cv
      </a>
      <p
        class="invisible pt-4 font-mono text-[11px] text-muted-foreground"
        data-globe-hint
        aria-hidden="true"
      >
        Drag to rotate, or pick a place
      </p>
    </div>

    <div class="shrink-0 space-y-2">
      <p class="font-mono text-xs text-muted-foreground">Experience</p>
      <ul class="space-y-1 font-mono text-[11px] leading-tight text-muted-foreground">
        {
          pins.map((pin) => (
            <li>
              <button
                type="button"
                class="globe-focus flex w-full cursor-pointer items-center gap-2 whitespace-nowrap text-left text-muted-foreground transition-colors hover:text-foreground hover:underline focus-visible:text-foreground focus-visible:underline disabled:pointer-events-none disabled:opacity-100 data-[active=true]:text-foreground data-[active=true]:underline"
                data-globe-focus={pin.id}
                data-active="false"
                aria-label={`Rotate the globe to ${pin.place}`}
                aria-pressed="false"
                disabled
              >
                <span
                  class:list={[
                    "rounded-full",
                    pin.current ? "size-1.5 bg-foreground" : "size-1 bg-foreground/50",
                  ]}
                  aria-hidden="true"
                />
                <span>{pin.place}</span>
                <span class="text-muted-foreground/50" aria-hidden="true">·</span>
                <span>{pin.detail}</span>
              </button>
            </li>
          ))
        }
        <li class="flex items-center gap-2 whitespace-nowrap">
          <span
            class="size-1 rounded-full border border-muted-foreground/50"
            aria-hidden="true"
          />
          <span>Remote</span>
          <span class="text-muted-foreground/50" aria-hidden="true">·</span>
          <span>Kalbe Farma</span>
        </li>
      </ul>
    </div>
  </div>

  <div
    class="relative w-full overflow-hidden"
    style="--globe-size: min(100vw, 90rem); height: calc(var(--globe-size) / 2);"
    data-globe-stage
  >
    <div
      class="absolute left-1/2 top-0 h-[var(--globe-size)] w-[var(--globe-size)] -translate-x-1/2 overflow-hidden rounded-full border border-border"
      data-globe-shell
    >
      <canvas
        width="440"
        height="440"
        class="absolute inset-0 size-full touch-pan-y outline-none"
        aria-hidden="true"
        tabindex="-1"
        role="img"
        aria-label={`Interactive globe of experience locations: ${pins.map((pin) => pin.place).join(", ")}. Drag or use arrow keys to rotate.`}
        aria-describedby="globe-instructions"
        data-globe
        data-markers={JSON.stringify(markers)}
      ></canvas>

      <svg
        viewBox="0 0 100 100"
        class="pointer-events-none absolute inset-0 size-full text-muted-foreground/60"
        aria-hidden="true"
        data-globe-fallback
      >
        <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
          <circle cx="50" cy="50" r="46" vector-effect="non-scaling-stroke" />
          <ellipse cx="50" cy="50" rx="18" ry="46" vector-effect="non-scaling-stroke" />
          <ellipse cx="50" cy="50" rx="36" ry="46" vector-effect="non-scaling-stroke" />
          <path d="M4 50h92M12 30h76M12 70h76" vector-effect="non-scaling-stroke" />
        </g>
        <g data-globe-fallback-pins class="text-foreground" fill="currentColor">
          <circle cx="69.8" cy="12.4" r="1.1" />
          <circle cx="48.1" cy="39.7" r="0.65" />
          <circle cx="49" cy="40.3" r="0.65" />
        </g>
      </svg>

      {
        pins.map((pin) => (
          <span
            class="globe-label z-10 rounded-sm border border-border bg-background px-2 py-1 font-mono text-[11px] leading-none text-muted-foreground"
            data-globe-label={pin.id}
            data-active="false"
            aria-hidden="true"
            style={`position-anchor: --cobe-${pin.id}; --globe-visible: var(--cobe-visible-${pin.id}, 0);`}
          >
            {pin.current ? `${pin.place} · now` : pin.place}
          </span>
        ))
      }
    </div>
  </div>

  <p id="globe-instructions" class="sr-only">
    Drag the globe or use the arrow keys to rotate it. Choose a place in the
    experience list to rotate its pin into view. Pins mark Shizuoka,
    Tangerang, and Bandung. The Kalbe Farma role was remote.
  </p>
</footer>

<style>
  [data-globe-shell]:has(canvas:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 4px;
  }

  .globe-focus:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  [data-globe-shell][data-ready] canvas {
    cursor: grab;
  }

  [data-globe-shell][data-ready] canvas:active {
    cursor: grabbing;
  }

  [data-globe-shell][data-ready] [data-globe-fallback-pins] {
    opacity: 0;
  }

  [data-globe-fallback-pins] {
    transition: opacity 240ms ease-out;
  }

  .globe-label {
    position: absolute;
    bottom: anchor(top);
    left: anchor(center);
    display: none;
    translate: -50% -8px;
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
    transition: opacity 160ms ease-out;
  }

  @supports (position-anchor: --test) {
    .globe-label {
      display: block;
    }
  }

  .globe-label[data-active="true"] {
    opacity: var(--globe-visible, 0);
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-globe]");
  const shell = document.querySelector<HTMLElement>("[data-globe-shell]");
  const hint = document.querySelector<HTMLElement>("[data-globe-hint]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (canvas && shell) {
    const init = async () => {
      if (reduceMotion.matches) return;

      try {
        const { default: createGlobe } = await import("cobe");

        let size = Math.round(shell.getBoundingClientRect().width);
        let phi = 2.6;
        let theta = -0.32;
        let dragging = false;
        let hovering = false;
        let pointerId: number | null = null;
        let lastX = 0;
        let lastY = 0;
        let velocity = 0;
        let lastInteraction = performance.now();
        let activePin: string | null = null;
        let targetPhi: number | null = null;
        let focused = false;
        let raf = 0;
        let lastFrame = 0;
        let dirty = true;

        const focusButtons = Array.from(
          document.querySelectorAll<HTMLButtonElement>("[data-globe-focus]"),
        );
        const labels = Array.from(
          document.querySelectorAll<HTMLElement>("[data-globe-label]"),
        );

        const markers = JSON.parse(canvas.dataset.markers ?? "[]") as {
          location: [number, number];
          size: number;
          id?: string;
        }[];

        const globe = createGlobe(canvas, {
          devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
          width: size,
          height: size,
          phi,
          theta,
          dark: 0,
          diffuse: 1.2,
          scale: 1.2,
          mapSamples: 16000,
          mapBrightness: 6,
          mapBaseBrightness: 0,
          baseColor: [0.92, 0.92, 0.92],
          markerColor: [0.145, 0.145, 0.145],
          glowColor: [1, 1, 1],
          markers,
          markerElevation: 0.015,
        });

        const clamp = (value: number, min: number, max: number) =>
          Math.min(max, Math.max(min, value));
        const TWO_PI = Math.PI * 2;

        const setActivePin = (id: string | null) => {
          activePin = id;

          for (const label of labels) {
            label.dataset.active = String(label.dataset.globeLabel === id);
          }

          for (const button of focusButtons) {
            const isActive = button.dataset.globeFocus === id;
            button.dataset.active = String(isActive);
            button.setAttribute("aria-pressed", String(isActive));
          }
        };

        const focusLocation = (id: string) => {
          const marker = markers.find((candidate) => candidate.id === id);
          if (!marker) return;

          if (activePin === id) {
            setActivePin(null);
            targetPhi = null;
            velocity = 0;
            lastInteraction = performance.now();
            return;
          }

          const desiredPhi =
            Math.PI - ((marker.location[1] * Math.PI) / 180 - Math.PI / 2);
          const currentPhi = ((phi % TWO_PI) + TWO_PI) % TWO_PI;
          const goalPhi = ((desiredPhi % TWO_PI) + TWO_PI) % TWO_PI;
          let delta = goalPhi - currentPhi;
          if (delta > Math.PI) delta -= TWO_PI;
          else if (delta < -Math.PI) delta += TWO_PI;

          targetPhi = phi + delta;
          velocity = 0;
          setActivePin(id);
          lastInteraction = performance.now();
        };

        const frame = (now: number) => {
          const delta = lastFrame ? Math.min(now - lastFrame, 64) : 16.667;
          lastFrame = now;
          const step = delta / 16.667;
          let changed = false;

          if (targetPhi !== null) {
            const distance = targetPhi - phi;
            if (Math.abs(distance) < 0.0005) {
              phi = targetPhi;
              targetPhi = null;
            } else {
              phi += distance * Math.min(1, 0.12 * step);
            }
            changed = true;
          } else if (!dragging) {
            if (Math.abs(velocity) > 0.0002) {
              phi += velocity * step;
              velocity *= Math.pow(0.92, step);
              if (Math.abs(velocity) <= 0.0002) velocity = 0;
              changed = true;
            } else if (
              !reduceMotion.matches &&
              !hovering &&
              !focused &&
              !activePin &&
              now - lastInteraction > 2400
            ) {
              phi += 0.0015 * step;
              changed = true;
            }
          }

          if (changed || dirty) {
            globe.update({ phi, theta });
            dirty = false;
          }

          raf = requestAnimationFrame(frame);
        };

        const startAnimation = () => {
          if (raf) return;
          lastFrame = performance.now();
          dirty = true;
          raf = requestAnimationFrame(frame);
        };

        const stopAnimation = () => {
          if (!raf) return;
          cancelAnimationFrame(raf);
          raf = 0;
          lastFrame = 0;
        };

        shell.dataset.ready = "true";
        canvas.removeAttribute("aria-hidden");
        canvas.tabIndex = 0;
        if (hint) {
          hint.classList.remove("invisible");
          hint.removeAttribute("aria-hidden");
        }

        for (const button of focusButtons) {
          button.disabled = false;
          button.addEventListener("click", () => {
            const id = button.dataset.globeFocus;
            if (id) focusLocation(id);
          });
        }

        if ("IntersectionObserver" in window) {
          const visibilityObserver = new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                startAnimation();
              } else {
                stopAnimation();
              }
            },
            { rootMargin: "100px" },
          );
          visibilityObserver.observe(shell);
        } else {
          startAnimation();
        }

        const endDrag = (event: PointerEvent) => {
          if (pointerId !== event.pointerId) return;
          dragging = false;
          pointerId = null;
          lastInteraction = performance.now();
          if (canvas.hasPointerCapture(event.pointerId)) {
            canvas.releasePointerCapture(event.pointerId);
          }
        };

        canvas.addEventListener("pointerdown", (event) => {
          if (event.pointerType === "mouse" && event.button !== 0) return;
          if (event.pointerType !== "touch") event.preventDefault();
          setActivePin(null);
          targetPhi = null;
          dragging = true;
          hovering = true;
          pointerId = event.pointerId;
          lastX = event.clientX;
          lastY = event.clientY;
          velocity = 0;
          lastInteraction = performance.now();
          canvas.setPointerCapture(event.pointerId);
        });

        canvas.addEventListener("pointermove", (event) => {
          if (!dragging || pointerId !== event.pointerId) return;
          if (event.pointerType !== "touch") event.preventDefault();

          const dx = event.clientX - lastX;
          const dy = event.clientY - lastY;
          lastX = event.clientX;
          lastY = event.clientY;

          phi += dx * 0.005;
          theta = clamp(theta + dy * 0.004, -0.75, 0.45);
          velocity = dx * 0.005;
          lastInteraction = performance.now();
          dirty = true;
        });

        canvas.addEventListener("pointerup", endDrag);
        canvas.addEventListener("pointercancel", endDrag);
        canvas.addEventListener("lostpointercapture", endDrag);

        shell.addEventListener("pointerenter", () => {
          hovering = true;
        });

        shell.addEventListener("pointerleave", () => {
          hovering = false;
          lastInteraction = performance.now();
        });

        canvas.addEventListener("keydown", (event) => {
          const step = 0.12;
          let handled = true;

          switch (event.key) {
            case "ArrowLeft":
              phi -= step;
              break;
            case "ArrowRight":
              phi += step;
              break;
            case "ArrowUp":
              theta = clamp(theta - step, -0.75, 0.45);
              break;
            case "ArrowDown":
              theta = clamp(theta + step, -0.75, 0.45);
              break;
            case "Escape":
              break;
            default:
              handled = false;
          }

          if (!handled) return;
          event.preventDefault();
          targetPhi = null;
          setActivePin(null);
          velocity = 0;
          lastInteraction = performance.now();
          dirty = true;
        });

        canvas.addEventListener("focus", () => {
          focused = true;
          lastInteraction = performance.now();
        });

        canvas.addEventListener("blur", () => {
          focused = false;
          lastInteraction = performance.now();
        });

        window.addEventListener("resize", () => {
          const next = Math.round(shell.getBoundingClientRect().width);
          if (next === size) return;
          size = next;
          globe.update({ width: size, height: size, phi, theta });
        });
      } catch {
        // The static SVG globe and its pins remain.
      }
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          void init();
        },
        { rootMargin: "300px" },
      );
      observer.observe(shell);
    } else {
      void init();
    }
  }
</script>
