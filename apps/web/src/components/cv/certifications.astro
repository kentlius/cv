---
import Card from "@/components/local/card.astro";
import CardHeader from "@/components/local/card-header.astro";
import Section from "@/components/local/section.astro";

interface Props {
  items: Array<{
    name: string;
    detail?: string;
    href?: string;
    date?: string;
    summary?: string;
  }>;
}

const { items } = Astro.props;
---

{
  items.length > 0 ? (
    <Section>
      <h2 class="text-xl font-bold" data-reveal>Certifications</h2>
      {items.map((item) => (
        <Card>
          <CardHeader>
            <div class="flex flex-col gap-1 text-base sm:grid sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-x-2">
              <h3 class="min-w-0 font-semibold leading-tight text-pretty [overflow-wrap:anywhere]">
                {item.href ? (
                  <a
                    class="hover:underline"
                    href={item.href}
                    target="_blank"
                    rel="noreferrer noopener"
                    data-confetti-hover
                  >
                    {item.name}
                  </a>
                ) : (
                  item.name
                )}
              </h3>
              {item.detail ? (
                item.href ? (
                  <a
                    class="font-mono text-sm leading-tight text-muted-foreground hover:underline sm:col-start-1 sm:row-start-2"
                    href={item.href}
                    target="_blank"
                    rel="noreferrer noopener"
                  >
                    {item.detail}
                  </a>
                ) : (
                  <p class="font-mono text-sm leading-tight text-muted-foreground sm:col-start-1 sm:row-start-2">
                    {item.detail}
                  </p>
                )
              ) : null}
              {item.date ? (
                <div class="text-sm tabular-nums text-muted-foreground sm:col-start-2 sm:row-start-1 sm:justify-self-end sm:whitespace-nowrap">
                  {item.date}
                </div>
              ) : null}
            </div>
            {item.summary ? (
              <p class="text-xs text-muted-foreground">{item.summary}</p>
            ) : null}
          </CardHeader>
        </Card>
      ))}
    </Section>
  ) : null
}
