---
import Card from "@/components/local/card.astro";
import CardContent from "@/components/local/card-content.astro";
import CardHeader from "@/components/local/card-header.astro";
import Section from "@/components/local/section.astro";

interface Props {
  items: Array<{
    institution: string;
    location?: string;
    dates: string;
    credential?: string;
    highlights: string[];
  }>;
}

const { items } = Astro.props;
---

{
  items.length > 0 ? (
    <Section>
      <h2 class="text-xl font-bold" data-reveal>Education</h2>
      {items.map((item) => (
        <Card>
          <CardHeader>
            <div class="flex flex-col gap-1 text-base sm:grid sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-x-2">
              <h3 class="min-w-0 font-semibold leading-tight text-pretty [overflow-wrap:anywhere]">
                {item.institution}
              </h3>
              {item.credential || item.location ? (
                <p class="font-mono text-sm leading-tight text-muted-foreground sm:col-start-1 sm:row-start-2 [overflow-wrap:anywhere]">
                  {[item.credential, item.location].filter(Boolean).join(" ·\u00A0")}
                </p>
              ) : null}
              <div class="text-sm tabular-nums text-muted-foreground sm:col-start-2 sm:row-start-1 sm:justify-self-end sm:whitespace-nowrap">
                {item.dates}
              </div>
            </div>
          </CardHeader>
          {item.highlights.length > 0 ? (
            <CardContent>
              <ul class="list-disc space-y-1 pl-4">
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </CardContent>
          ) : null}
        </Card>
      ))}
    </Section>
  ) : null
}
