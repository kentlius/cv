{
  "name": "kentlius-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the Astro CV site and the rendercv CV pipeline",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "cv:sync": "uv sync --project cv",
    "cv:build": "cd cv && uv run python scripts/build_cv.py",
    "cv:render": "bash cv/scripts/render-all.sh",
    "test": "pnpm --filter web test"
  }
}
